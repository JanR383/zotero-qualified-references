# Copy to .env and adjust for local development (`npm start`).
# Path to the Zotero 9 binary:
#   macOS:   /Applications/Zotero.app/Contents/MacOS/zotero
#   Linux:   /opt/zotero/zotero
#   Windows: C:\\Program Files\\Zotero\\zotero.exe
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero

# Path to a *dedicated development* Zotero profile (NOT your main profile).
# Create one via: <zotero-bin> -P
ZOTERO_PLUGIN_PROFILE_PATH=/Users/you/Zotero/Profiles/dev
